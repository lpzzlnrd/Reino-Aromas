# =============================================================================
# .env.production.example — plantilla del .env que vive EN EL VPS
#
# Copiar a .env en el directorio del repo en el VPS y rellenar. NO se commitea
# (.gitignore ya excluye .env y .env.production).
#
#   cp .env.production.example .env
#   docker compose run --rm --no-deps app php artisan key:generate --show
#   # pegar el resultado en APP_KEY
# =============================================================================

APP_NAME="Reino Aromas"
APP_ENV=production
# Generar con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://reinoaromas.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# stderr para que `docker compose logs` muestre todo.
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Base de datos — MySQL EXTERNO (gestionado)
# El VPS debe poder alcanzar este host; autoriza su IP en el panel del
# proveedor de la base de datos.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=reino_aromas
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis (contenedor del compose) — cache, colas y sesiones
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Obligatoria: el compose arranca redis-server con --requirepass.
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Punto inicial => cookie válida también en subdominios.
SESSION_DOMAIN=.reinoaromas.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@reinoaromas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Caddy / TLS
# APP_DOMAIN también lo usa Sanctum. Sin www ni https:// — solo el host.
# ---------------------------------------------------------------------------
APP_DOMAIN=reinoaromas.com
LETSENCRYPT_EMAIL=lcorrea@botinfy.com

# ---------------------------------------------------------------------------
# Sanctum — SPA en el mismo dominio
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=reinoaromas.com,www.reinoaromas.com

# ---------------------------------------------------------------------------
# Meta / WhatsApp & Instagram
# ---------------------------------------------------------------------------
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_INSTAGRAM_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
