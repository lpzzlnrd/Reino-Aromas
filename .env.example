APP_NAME="Reino Aromas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos
# En Docker: DB_HOST=mysql  (nombre del servicio en docker-compose.yml)
# En local Laragon: DB_HOST=127.0.0.1
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reino_aromas
DB_USERNAME=root
DB_PASSWORD=
# Contraseña root del contenedor MySQL (solo Docker)
DB_ROOT_PASSWORD=secret_root
# Puerto del contenedor MySQL expuesto al host (solo dev)
DB_EXPOSE_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@reinoaromas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Laravel Reverb — WebSockets self-hosted
#
# Sustituye a Soketi, que estaba planeado aquí pero nunca se instaló: quedó
# archivado en 2024 y no acompaña a PHP 8.4. Reverb habla el mismo protocolo
# de Pusher, así que Laravel Echo se configura igual.
#
# GENERAR CREDENCIALES PROPIAS EN EL VPS — estos valores son de ejemplo:
#   php artisan reverb:install    (las escribe en el .env)
#
# El servidor corre como servicio systemd, igual que la cola:
#   php artisan reverb:start --host=127.0.0.1 --port=8080
# y nginx hace proxy del WebSocket hacia ese puerto.
# ---------------------------------------------------------------------------
REVERB_APP_ID=reino_app_id
REVERB_APP_KEY=reino_app_key
REVERB_APP_SECRET=reino_app_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
# URL del backend Laravel — usada por Vue para saber a dónde apuntar en dev
VITE_APP_URL="${APP_URL}"
# Clave pública de Reverb — expuesta al frontend para Laravel Echo.
# En producción el host es el dominio y el scheme https (wss), no 127.0.0.1.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# Sanctum — dominios con sesión stateful (SPA mismo dominio)
# En prod: APP_DOMAIN=tudominio.com
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
APP_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Meta / WhatsApp, Instagram & Facebook
#
# El verify token lo inventa el dev (no lo da Meta) y debe ser el MISMO valor
# aquí y en el dashboard. Un solo token sirve para las tres redes.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_INSTAGRAM_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=

# Embedded Signup: el popup de vinculación de /app/settings/accounts.
# Un "config" por canal, creado en el dashboard de Meta:
#   Facebook Login for Business > Configurations > Create
# Crearlas como v4: la v2 se deprecia el 15 de octubre de 2026.
# Sin estos ids la vista de Cuentas muestra el botón deshabilitado y explica
# qué falta, en vez de abrir un popup roto.
META_SIGNUP_WHATSAPP_CONFIG_ID=
META_SIGNUP_INSTAGRAM_CONFIG_ID=
META_SIGNUP_FACEBOOK_CONFIG_ID=

# Facebook Messenger. El token es el DE LA PÁGINA, no el de la app.
# Sin PAGE_ID no se puede responder por Messenger y los mensajes entrantes se
# procesan a medias: es lo que distingue quién habla en cada evento.
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=

# Solo para vincular la Página por OAuth (GET /api/meta/facebook/auth-url).
# Debe coincidir EXACTAMENTE con la URI registrada en el dashboard de Meta.
FACEBOOK_REDIRECT_URI=

# Datos legales de la empresa (los usan las paginas publicas de /privacidad,
# /terminos y /eliminacion-de-datos que Meta revisa en App Review).
# PENDIENTE: pedir los valores reales al cliente.
EMPRESA_RAZON_SOCIAL=
EMPRESA_RIF=
EMPRESA_CORREO=
EMPRESA_TELEFONO=
EMPRESA_DIRECCION=
EMPRESA_CIUDAD_JURISDICCION=
EMPRESA_LEGAL_ACTUALIZADO=

# WhatsApp Flows — par RSA del canal de datos cifrado.
# Generar con: php artisan flows:generate-keys
# Subir la publica con: php artisan flows:upload-key
# La privada va entre comillas dobles y los saltos escapados (barra-n).
FLOWS_PRIVATE_KEY=
FLOWS_PASSPHRASE=

# Flow de bienvenida. Si FLOWS_WELCOME_ID esta vacio el disparo automatico
# queda DESACTIVADO y todo sigue como hoy (ticket creado, agente atiende).
FLOWS_WELCOME_ID=
FLOWS_WELCOME_CTA=
FLOWS_WELCOME_FIRST_SCREEN=
FLOWS_WELCOME_BODY=
