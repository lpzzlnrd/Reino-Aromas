APP_NAME="Reino Aromas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos
# En Docker: DB_HOST=mysql  (nombre del servicio en docker-compose.yml)
# En local Laragon: DB_HOST=127.0.0.1
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reino_aromas
DB_USERNAME=root
DB_PASSWORD=
# Contraseña root del contenedor MySQL (solo Docker)
DB_ROOT_PASSWORD=secret_root
# Puerto del contenedor MySQL expuesto al host (solo dev)
DB_EXPOSE_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@reinoaromas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Soketi — WebSockets self-hosted (reemplaza Pusher en producción)
# BROADCAST_CONNECTION=pusher apuntando a Soketi local.
# En Docker: PUSHER_HOST=soketi  (nombre del servicio)
# En local:  PUSHER_HOST=127.0.0.1
# ---------------------------------------------------------------------------
PUSHER_APP_ID=reino_app
PUSHER_APP_KEY=reino_key
PUSHER_APP_SECRET=reino_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
# URL del backend Laravel — usada por Vue para saber a dónde apuntar en dev
VITE_APP_URL="${APP_URL}"
# Clave pública de Soketi — expuesta al frontend para Laravel Echo
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# ---------------------------------------------------------------------------
# Sanctum — dominios con sesión stateful (SPA mismo dominio)
# En prod: APP_DOMAIN=tudominio.com
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
APP_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Meta / WhatsApp, Instagram & Facebook
#
# El verify token lo inventa el dev (no lo da Meta) y debe ser el MISMO valor
# aquí y en el dashboard. Un solo token sirve para las tres redes.
# ---------------------------------------------------------------------------
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_INSTAGRAM_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=

# Facebook Messenger. El token es el DE LA PÁGINA, no el de la app.
# Sin PAGE_ID no se puede responder por Messenger y los mensajes entrantes se
# procesan a medias: es lo que distingue quién habla en cada evento.
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Soketi puertos (solo Docker)
# ---------------------------------------------------------------------------
SOKETI_PORT=6001
SOKETI_METRICS_PORT=9601
SOKETI_DEBUG=0

# Datos legales de la empresa (los usan las paginas publicas de /privacidad,
# /terminos y /eliminacion-de-datos que Meta revisa en App Review).
# PENDIENTE: pedir los valores reales al cliente.
EMPRESA_RAZON_SOCIAL=
EMPRESA_RIF=
EMPRESA_CORREO=
EMPRESA_TELEFONO=
EMPRESA_DIRECCION=
EMPRESA_CIUDAD_JURISDICCION=
EMPRESA_LEGAL_ACTUALIZADO=

# WhatsApp Flows — par RSA del canal de datos cifrado.
# Generar con: php artisan flows:generate-keys
# Subir la publica con: php artisan flows:upload-key
# La privada va entre comillas dobles y los saltos escapados (barra-n).
FLOWS_PRIVATE_KEY=
FLOWS_PASSPHRASE=

# Flow de bienvenida. Si FLOWS_WELCOME_ID esta vacio el disparo automatico
# queda DESACTIVADO y todo sigue como hoy (ticket creado, agente atiende).
FLOWS_WELCOME_ID=
FLOWS_WELCOME_CTA=
FLOWS_WELCOME_FIRST_SCREEN=
FLOWS_WELCOME_BODY=
